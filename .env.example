# ─── Server ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://shipyard:change-me@postgres:5432/shipyard
POSTGRES_PASSWORD=change-me
PUBLIC_URL=http://localhost:3300
SESSION_SECRET=
# Reverse-proxy hops in front of the server (a Cloudflare tunnel is 1). Needed for per-IP sign-in
# throttling to see real client addresses; leave blank when nothing proxies the server.
TRUST_PROXY_HOPS=
# Fine-grained, read-only: Contents, Actions, Checks, Metadata (changelogs on the console)
GITHUB_TOKEN_SERVER=

# Optional — Sign in with D3 Auth. Leave blank for app-native login only.
D3AUTH_ISSUER=
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=

# Optional — record deploys in Foreman (write-scoped token)
FOREMAN_URL=
FOREMAN_TOKEN=

# Optional — agent-down email
MAIL_ADAPTER=none
MAIL_TO=

# ─── Agent ────────────────────────────────────────────────────────────────
SHIPYARD_SERVER_URL=http://server:3300
SHIPYARD_DATA_ROOT=/srv/shipyard
# Separate token from the server's, so the agent's verification stays independent
GITHUB_TOKEN_AGENT=
