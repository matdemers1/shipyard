# Copy to agent.env, mode 600. Replace every <placeholder>; never commit real values.
# See apps/agent/src/config.ts for the authoritative list of variables the agent reads.

# The server, reached over the compose network by its service name.
SHIPYARD_SERVER_URL=http://server:3300

# Must match the path the data volume is mounted at in compose.example.yml (./data:/data there).
# This is where the agent's Ed25519 key, journal and ledger live, and where onboarded apps' own
# manifests are read from.
SHIPYARD_DATA_ROOT=/data

# Optional — fine-grained, read-only GitHub PAT, kept separate from the server's so the agent's
# own re-verification stays independent. Public repos work without one, at GitHub's
# unauthenticated rate limit (60 requests/hour).
GITHUB_TOKEN_AGENT=

# Private images only: a docker config directory (mounted read-only into the agent) whose
# config.json holds a ghcr.io auth with read:packages. Public images need nothing.
# DOCKER_CONFIG=/docker-config

# ─── Builds (optional; SHP-P-7) ───────────────────────────────────────────────
# Leave BUILDKIT_ADDR unset and the agent never builds: it does not advertise the capability, and
# the server never sends it a build. To enable builds, first run build-network.sh and start
# buildkit.compose.yml (see README.md, "Builds: the build network and rootless BuildKit"), then give
# the agent the socket in docker-compose.yml:
#     volumes:   - shipyard-buildkit-socket:/run/buildkit   (and the volume as external: true)
#     group_add: ["1000"]                                     (buildkitd runs as uid 1000)
# The agent runs one build at a time, and never starts a build stage while a deploy is in flight.
# BUILDKIT_ADDR=unix:///run/buildkit/buildkitd.sock

# A docker config directory (mounted read-only) whose config.json holds the GHCR PUSH credential
# buildctl uses. Minimum scope: a classic PAT with write:packages (and nothing else), or a
# fine-grained token limited to the app image packages Shipyard builds. Keep it separate from
# DOCKER_CONFIG above, which only needs read:packages.
# BUILD_DOCKER_CONFIG=/build-docker-config

# Scratch space for extracted source and short-lived 0600 secret files. Default: <data root>/agent/build-tmp.
# BUILD_TMP_DIR=/data/agent/build-tmp

# Build secrets (a registry token a Dockerfile RUN --mount=type=secret needs) are NOT set here.
# They live encrypted on this host in <data root>/agent/build-secrets.json, sealed with a key
# derived from the agent's own key, and are set with the host CLI, value on stdin only:
#     printf %s "$NPM_TOKEN" | shipyard-run build-secret set <app> npm_token
#     shipyard-run build-secret list <app>
#     shipyard-run build-secret delete <app> npm_token
# The manifest names them (build.secrets); build output is redacted against them and against the
# app's envFiles before any of it reaches the server.
