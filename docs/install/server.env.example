# Copy to server.env, mode 600. Replace every <placeholder>; never commit real values.
# See apps/server/src/config.ts for the authoritative list of variables the server reads.

# Same password as postgres.env's POSTGRES_PASSWORD.
DATABASE_URL=postgresql://shipyard:<random>@postgres:5432/shipyard

# A random 32-byte hex secret (head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'). Signs the
# short-lived MFA-step cookie; unset works too (one is generated per process) but every restart
# then invalidates any sign-in in progress.
SESSION_SECRET=<random 32 bytes hex>

# The externally reachable URL of this server. Matters beyond cosmetics: the session cookie is
# marked Secure only when this starts with https:// (apps/server/src/auth/cookies.ts) — a
# tunnel-free, plain-http quick start MUST use http://… here (e.g. http://localhost:3466) or the
# browser will never send the cookie back and sign-in will silently loop.
PUBLIC_URL=http://localhost:3466

# Reverse-proxy hops in front of the server (a tunnel is 1). Needed for per-IP sign-in throttling
# to see real client addresses. Leave blank when nothing proxies the server, as in this example.
TRUST_PROXY_HOPS=

# Where the nightly pg_dump + restore-drill artifacts are written inside the container — must
# match the volume mount in compose.example.yml.
BACKUP_DIR=/backups

# --- Everything below is OPTIONAL. Leave every line blank for a minimal, D3-Auth-free install ---

# Optional: how many days of dumps to keep (default 14; the newest three are always kept).
BACKUP_RETENTION_DAYS=

# Optional — Sign in with D3 Auth. Leave ALL THREE blank for app-native password + TOTP login
# only (this is the default for this example; nothing here requires D3 Auth). An admin can instead
# configure it in the console (Settings → Sign in with D3 Auth), no restart needed; any of these
# set here wins, and the console then shows them read-only.
D3AUTH_ISSUER=
D3AUTH_CLIENT_ID=
D3AUTH_CLIENT_SECRET=

# Optional — record deploys in a Foreman instance (a write-scoped token).
FOREMAN_URL=
FOREMAN_TOKEN=

# Optional — fine-grained, read-only GitHub PAT for changelogs on the console. Public repos work
# without one, at GitHub's unauthenticated rate limit.
GITHUB_TOKEN_SERVER=

# Optional — alert email through an HTTP mail relay. Unset means alerts are only logged.
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
ALERT_TO=
