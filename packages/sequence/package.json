{
  "name": "@shipyard/sequence",
  "private": true,
  "version": "0.0.0",
  "description": "The deploy engine: gates, state machine, step compiler, journal, ledger, rollback. Used by the agent and the CLI; no deploy logic anywhere else",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @shipyard/schema build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@shipyard/schema": "workspace:*",
    "dockerode": "^5.0.1"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1"
  }
}
