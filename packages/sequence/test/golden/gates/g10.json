      {
        "gate": "G8",
        "pass": true
      },
      {
        "gate": "G10",
        "pass": false,
        "code": "later_contract_release"
      }
    ]
  },
  {
    "name": "refuses when a later release carries the contract label with surrounding whitespace",
    "facts": {
      "kind": "rollback",
      "laterMigrationLabels": [
