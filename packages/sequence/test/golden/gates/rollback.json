[
  {
    "name": "skips CI, default-branch and ahead-of-live even when those facts would fail",
    "facts": {
      "kind": "rollback",
      "workflowRuns": [],
      "onDefaultBranch": { "status": "behind" },
      "aheadOfLive": { "status": "behind" },
      "live": { "sha": "facadefacadefacadefacadefacadefacadeface" }
    },
    "expect": [
      { "gate": "disk", "pass": true },
      { "gate": "G8", "pass": true }
    ]
  },
  {
    "name": "still evaluates env and disk for a rollback",
    "facts": {
      "kind": "rollback",
      "manifest": { "requiredEnv": ["TOKEN"] },
      "envNamesPresent": []
    },
    "expect": [
      { "gate": "disk", "pass": true },
      { "gate": "G8", "pass": true },
      { "gate": "G9", "pass": false, "code": "env_missing" }
    ]
  },
  {
    "name": "reports insufficient disk and a later contract release together",
    "facts": {
      "kind": "rollback",
      "freeBytes": 1024,
      "laterMigrationLabels": ["contract"]
    },
    "expect": [
      { "gate": "disk", "pass": false, "code": "insufficient_disk" },
      { "gate": "G8", "pass": true },
      { "gate": "G10", "pass": false, "code": "later_contract_release" }
    ]
  }
]
